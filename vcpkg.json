{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "safebox",
  "version": "2.0.0",
  "dependencies": [
    "libsodium",
    "sqlite3",
    "nlohmann-json",
    "fmt",
    {
      "name": "cpp-httplib",
      "default-features": false
    },
    "stb",
    "miniz",
    "libwebp"
  ],
  "features": {
    "tests": {
      "description": "Catch2 unit/integration tests; включается автоматически при -DSAFEBOX_BUILD_TESTS=ON",
      "dependencies": [
        "catch2"
      ]
    }
  }
}
